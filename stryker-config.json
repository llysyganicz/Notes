{
  "stryker-config": {
    "test-runner": "mtp",
    "project": "Notes.Core.csproj",
    "mutate": [
      "**/Services/TemplateRenderer.cs",
      "**/Services/TemplateParser.cs",
      "**/Services/TemplateCatalog.cs",
      "**/Services/NameValidator.cs",
      "**/Services/PathGuard.cs",
      "**/Services/NoteFileService.cs",
      "**/Services/NoteDeleter.cs",
      "**/Services/NoteFolderService.cs",
      "**/Services/OrphanedTempCleaner.cs",
      "**/ViewModels/TemplateFormViewModel.cs",
      "**/ViewModels/Fields/*.cs",
      "!**/*.axaml.cs"
    ],
    "reporters": ["html", "json", "cleartext"],
    "concurrency": 4
  }
}
