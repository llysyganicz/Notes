<?xml version="1.0"?>
<!--
  Gruvbox re-color of AvaloniaEdit's built-in "MarkDown" highlighting
  definition (avalonia.avaloniaedit's embedded
  AvaloniaEdit.Highlighting.Resources.MarkDown-Mode.xshd, extracted via
  reflection during Phase 2 research). Rule structure (regexes, spans,
  rule set) is ported 1:1; only the six <Color> foreground/fontWeight/
  fontStyle values are gruvbox and templated with __TOKEN__ placeholders
  so Notes/Services/GruvboxHighlightingLoader.cs can substitute the active
  ThemeVariant's hex values before parsing (.xshd has no DynamicResource
  equivalent - colors are load-time literals).
-->
<SyntaxDefinition name="GruvboxMarkDown" extensions=".md" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
	<Color name="Heading" foreground="__HEADING__" fontWeight="bold" exampleText="# Title #" />
	<Color name="Emphasis" foreground="__EMPHASIS__" fontStyle="italic" exampleText="*this* is important!" />
	<Color name="StrongEmphasis" foreground="__STRONG__" fontWeight="bold" exampleText="**this** is more important!" />
	<Color name="Code" foreground="__CODE__" exampleText="this is `int.GetHashCode()`" />
	<Color name="BlockQuote" foreground="__BLOCKQUOTE__" exampleText="&gt; This is a\r\n&gt; quote." />
	<Color name="Link" foreground="__LINK__" exampleText="[text](http://example.com)" />
	<Color name="Image" foreground="__IMAGE__" exampleText="[text][http://example.com/test.png]" />
	<Color name="LineBreak" background="__LINEBREAK_BG__" exampleText="end of line      \r\n2nd line   " />

	<RuleSet ignoreCase="true">
		<Rule color="Heading">
			^\#.*
		</Rule>
		<Rule color="StrongEmphasis">
			\*\*.*\*\*
		</Rule>
		<Rule color="StrongEmphasis">
			__.*__
		</Rule>
		<Rule color="Emphasis">
			\*(?![ ]).*\*
		</Rule>
		<Rule color="Emphasis">
			_.*_
		</Rule>
		<Rule color="Code">
			`.*`
		</Rule>
		<Span color="Code" ruleSet="C#/" multiline="true">
			<Begin>^\t</Begin>
			<End>^(?!\t)</End>
		</Span>
		<Span color="Code" ruleSet="C#/" multiline="true">
			<Begin>^[ ]{4}</Begin>
			<End>^(?![ ]{4})</End>
		</Span>
		<Span color="BlockQuote" multiline="true">
			<Begin>^&gt;</Begin>
			<End>^(?!&gt;)</End>
		</Span>
		<Rule color="Image">
			\!\[.*\]\[.*\]
		</Rule>
		<Rule color="Link">
			\[.*\]\(.*\)
		</Rule>
		<Rule color="Link">
			\[.*\]\[.*\]
		</Rule>
		<Rule color="LineBreak">
			[ ]{2}$
		</Rule>
	</RuleSet>
</SyntaxDefinition>
