<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    ScrollViewer + ScrollBar. Minimal gruvbox scrollbar: a track (click to
    page) plus a thumb; no line-up/down arrow buttons (PART_LineUpButton /
    PART_LineDownButton are optional per Avalonia.Controls.Primitives.ScrollBar
    and are intentionally omitted here for a cleaner, flatter look).
  -->

  <ControlTheme x:Key="{x:Type ScrollViewer}" TargetType="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,Auto">
          <ScrollContentPresenter Name="PART_ContentPresenter"
                                  Grid.Row="0"
                                  Grid.Column="0"
                                  Background="{TemplateBinding Background}"
                                  HorizontalSnapPointsAlignment="{TemplateBinding HorizontalSnapPointsAlignment}"
                                  HorizontalSnapPointsType="{TemplateBinding HorizontalSnapPointsType}"
                                  VerticalSnapPointsAlignment="{TemplateBinding VerticalSnapPointsAlignment}"
                                  VerticalSnapPointsType="{TemplateBinding VerticalSnapPointsType}"
                                  Padding="{TemplateBinding Padding}" />
          <ScrollBar Name="PART_HorizontalScrollBar" Orientation="Horizontal" Grid.Row="1" Grid.Column="0" />
          <ScrollBar Name="PART_VerticalScrollBar" Orientation="Vertical" Grid.Row="0" Grid.Column="1" />
        </Grid>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="GruvboxScrollBarThumb" TargetType="Thumb">
    <Setter Property="Background" Value="{DynamicResource ScrollBarThumb}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" Margin="2" />
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border">
      <Setter Property="Background" Value="{DynamicResource ScrollBarThumbHover}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="GruvboxScrollBarPageButton" TargetType="RepeatButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="MinHeight" Value="10" />
    <Setter Property="Background" Value="Transparent" />

    <Style Selector="^:vertical">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" Width="10">
            <Track Orientation="Vertical" Value="{TemplateBinding Value, Mode=TwoWay}"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   ViewportSize="{TemplateBinding ViewportSize}">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource GruvboxScrollBarPageButton}" Focusable="False" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource GruvboxScrollBarPageButton}" Focusable="False" />
              </Track.IncreaseButton>
              <Thumb Theme="{StaticResource GruvboxScrollBarThumb}" MinHeight="24" />
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>

    <Style Selector="^:horizontal">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" Height="10">
            <Track Orientation="Horizontal" Value="{TemplateBinding Value, Mode=TwoWay}"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   ViewportSize="{TemplateBinding ViewportSize}">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource GruvboxScrollBarPageButton}" Focusable="False" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource GruvboxScrollBarPageButton}" Focusable="False" />
              </Track.IncreaseButton>
              <Thumb Theme="{StaticResource GruvboxScrollBarThumb}" MinWidth="24" />
            </Track>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
  </ControlTheme>

</ResourceDictionary>
