<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Notes.ViewModels"
             xmlns:edit="https://github.com/avaloniaui/avaloniaedit"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             mc:Ignorable="d"
             x:Class="Notes.Views.NoteEditorView"
             x:DataType="vm:NoteEditorViewModel"
             DataContext="{ReflectionBinding Editor, Source={StaticResource Locator}}">
    <Grid>
        <TextBlock Text="Select a note to edit"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Opacity="0.6"
                   IsVisible="{Binding IsEmpty}" />
        <edit:TextEditor x:Name="Editor"
                         ShowLineNumbers="True"
                         WordWrap="True"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         IsVisible="{Binding IsEditing}" />
        <Border Background="{DynamicResource Background}"
                IsVisible="{Binding IsPreviewing}">
            <!--
                MarkdownStyle is set from code-behind (NoteEditorView.axaml.cs),
                not as a XAML attribute here: MarkdownScrollViewer.MarkdownStyleProperty
                is a *private* backing field, and Avalonia's compiled-bindings
                compiler emits a direct field-access IL instruction for it, which
                throws FieldAccessException across assemblies at runtime.
            -->
            <md:MarkdownScrollViewer x:Name="Preview"
                                     Markdown="{Binding PreviewText}"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch" />
        </Border>
    </Grid>
</UserControl>
